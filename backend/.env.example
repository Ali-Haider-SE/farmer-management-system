PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
DATABASE_URL=postgresql://farmer_app_user:YOUR_PASSWORD@localhost:5432/farmer_management

# Comma-separated browser origins. Use * only for local development.
CORS_ORIGINS=*
AUTH_RATE_LIMIT=20
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_SSL=false

JWT_EXPIRES_IN=7d
